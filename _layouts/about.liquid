---
layout: default
---
<div class="home">
  <section class="home-hero">
    <div class="home-hero-text">
      {% if page.eyebrow %}
        <p class="eyebrow">{{ page.eyebrow }}</p>
      {% endif %}
      <h1 class="home-headline">{{ page.headline | default: site.title }}</h1>
      <div class="home-lede">{{ content }}</div>
      {% if page.actions %}
        <div class="home-actions">
          {% for action in page.actions %}
            <a class="btn-portfolio{% if forloop.first %} btn-portfolio-primary{% endif %}" href="{{ action.url | relative_url }}">
              {{- action.label -}}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="home-photo">
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 576px) 200px, 120px" alt=site.title
          cache_bust=true
        %}
      </div>
    {% endif %}
  </section>

  {% if page.facts %}
    <ul class="home-facts">
      {% for fact in page.facts %}
        <li>
          <strong>{{ fact.value }}</strong>
          <span>{{ fact.label }}</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% assign featured_projects = site.projects | where: 'featured', true | sort: 'featured_order' %}
  {% if featured_projects.size > 0 %}
    <section class="home-section">
      <h2 class="section-title">Featured work</h2>
      <div class="feature-grid">
        {% for project in featured_projects %}
          {% include project_feature_card.liquid project=project %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Latest posts -->
  {% if page.latest_posts and page.latest_posts.enabled %}
    <section class="home-section">
      <h2 class="section-title">
        <a href="{{ '/blog/' | relative_url }}">Latest writing</a>
      </h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}
</div>
